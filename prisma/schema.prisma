generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  image    String?
  role     String  @default("user")
  password String
  posts    Post[]
}

model Post {
  id         String   @id @default(cuid())
  title      String
  content    String
  slug       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  authorId   String
  tags       String[]
  coverImage String?
  excerpt    String?
  status     String   @default("draft")
  author     User     @relation(fields: [authorId], references: [id])
}

enum StatusPost {
  draft
  public
}


